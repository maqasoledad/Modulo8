# Puerto en el que se levantará el servidor
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development

# Cadena de conexión a MongoDB
# Local: mongodb://localhost:27017/gestion-usuarios
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/gestion-usuarios
mongodb+srv://macarenasoledadsg_db_user:<macarenasoledadsg_db_user>@cluster0.g7rjyf9.mongodb.net/?appName=Cluster0

# Clave secreta para firmar los JWT (usá una cadena larga y aleatoria en producción)
JWT_SECRET=cambiar-esto-por-una-clave-secreta-larga-y-aleatoria
JWT_EXPIRES_IN=1d
